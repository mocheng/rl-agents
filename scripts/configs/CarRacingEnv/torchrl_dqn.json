    "collector_backend": "batched",
    "total_steps": 50000,
    "checkpoint_frequency": 50,
    "exploration": {
        "method": "EpsilonGreedy",
        "tau": 50000,
        "temperature": 1.0,
        "final_temperature": 0.05
    },
    "device": "auto"
}
