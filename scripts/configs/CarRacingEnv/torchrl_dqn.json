{
    "__class__": "<class 'rl_agents.agents.torchrl.dqn.TorchRLDQNAgent'>",
    "model": {
        "type": "ConvolutionalNetwork"
    },
    "double": true,
    "loss_function": "l2",
    "optimizer": {
        "lr": 1e-4
    },
    "gamma": 0.95,
    "n_steps": 1,
    "batch_size": 64,
