{
    "__class__": "<class 'rl_agents.agents.torchrl.dqn.TorchRLDQNAgent'>",
    "model": {
        "type": "NatureCNN"
    },
    "double": false,
    "loss_function": "l2",
    "optimizer": {
        "lr": 0.0001
    },
    "gamma": 0.99,
