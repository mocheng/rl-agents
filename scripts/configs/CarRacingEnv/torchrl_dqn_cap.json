    "total_steps": 500000,
    "checkpoint_frequency": 50,
    "keep_checkpoints": 3,
    "exploration": {
        "method": "EpsilonGreedy",
        "tau": 100000,
        "temperature": 1.0,
        "final_temperature": 0.1
    },
    "device": "auto"
}