{
    "__class__": "<class 'jax_agents.agents.dqn.JaxDQNAgent'>",
    "model": {
        "type": "ConvEncoder",
        "channels": [32, 64],
        "head_layers": [128]
    },
    "gamma": 0.97,
    "learning_rate": 1e-3,
    "grad_norm_clipping": 10.0,
    "batch_size": 256,
    "memory_capacity": 100000,
    "target_update": 500,
    "double": true,
    "num_envs": 64,
    "rollout_steps": 16,
    "updates_per_batch": 16,
    "total_steps": 500000,
    "exploration": {
        "method": "EpsilonGreedy",
        "initial": 1.0,
        "final": 0.01,
        "tau": 200000
    },
    "device": "auto"
}
